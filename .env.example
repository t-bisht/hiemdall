# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# Consumed by docker-compose.yml at `docker compose up`.

# ---- Registered-apps external file ---------------------------------------
# Host directory that contains registered-apps.yaml. The file is bind-mounted
# read-only into the container at /config/registered-apps.yaml.
# Defaults to the repo's ./config directory if unset.
HIEMDALL_CONFIG_DIR=./config

# ---- Image / port overrides ----------------------------------------------
HIEMDALL_IMAGE_TAG=0.1.0-SNAPSHOT
HIEMDALL_HOST_PORT=8082

# ---- Google OAuth --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_REDIRECT_URI=

# ---- Internal service-to-service token -----------------------------------
INTERNAL_SVC_TOKEN=change-me
